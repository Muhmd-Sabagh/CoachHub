root = true

# Dead-code checks (P18A). Directory.Build.props treats warnings as errors, so these fail the build.
[*.cs]
# Unnecessary using directives (needs GenerateDocumentationFile, set in Directory.Build.props).
dotnet_diagnostic.IDE0005.severity = warning
# Unused private members, and private members written but never read.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
# Unused parameters of non-public-API methods.
dotnet_diagnostic.IDE0060.severity = warning
# Unused value assignments.
dotnet_diagnostic.IDE0059.severity = warning

# Generated migrations are not hand-written code.
[**/Persistence/Migrations/*.cs]
generated_code = true
