{
  "CoachHub": {
    "CoachName": "CoachHub Development Coach"
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "development-only-signing-key-never-use-in-shared-or-production-environments"
    },
    "Experience": {
      "PasswordResetUrl": "https://localhost:4200/reset-password"
    }
  },
  "Media": {
    "Provider": "FileSystem",
    "StorageRoot": ".coachhub-media"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
